{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "@cortexkit/opencode-anthropic-auth@latest",
    "@slkiser/opencode-quota@latest",
  ],
  "compaction": {
    "reserved": 0,
  },
  "permission": {
    "external_directory": "allow",
    "read": {
      "**/.ssh/**": "deny",
      "**/.aws/credentials": "deny",
      "**/.netrc": "deny",
      "**/auth.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
    },
    "bash": {
      "rm -rf *": "ask",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git reset --hard*": "ask",
      "chmod 777 *": "ask",
    },
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-5": {
          "limit": { "context": 1000000, "input": 200000, "output": 128000 },
        },
      },
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": { "context": 1050000, "input": 200000, "output": 128000 },
        },
      },
    },
  },
}
