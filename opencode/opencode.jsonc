{
  "$schema": "https://opencode.ai/config.json",

  "plugins": ["@henadev/opencode-anthropic-auth@latest"],

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/auth.json", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },

    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "chmod 777 *", "effect": "ask" },
  ],

  // Read-only subagents for the pr-review skill. The model tiers follow the
  // upstream code-review plugin: Sonnet for summaries and rule checks, Opus for
  // bug work. The code quality track, which upstream does not have, also runs
  // on Opus.
  "agents": {
    "pr-review-standard": {
      "description": "Read-only reviewer for the pr-review skill: PR summaries, AGENTS.md compliance checks, and validating rule findings. Launch only from that skill.",
      "mode": "subagent",
      // "high" equals this model's default effort. The summary and rule work is
      // light, so it is not raised further.
      "model": "anthropic/claude-sonnet-5-5#high",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git blame *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
      ],
    },
    "pr-review-deep": {
      "description": "Read-only reviewer for the pr-review skill: finding and validating bugs and code quality issues. Launch only from that skill.",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5#xhigh",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git blame *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
      ],
    },
    // The approach deriver must not see the change under review. It gets no
    // shell, and it reads files only inside the base worktree the skill creates
    // (pr-review-base-*). grep and glob rules cannot match a search path, so
    // the skill's prompt tells the deriver where to search.
    "pr-review-deriver": {
      "description": "Approach deriver for the pr-review skill: designs the simplest change from the goal and the code before the change, without access to the change itself. Launch only from that skill.",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5#xhigh",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        {
          "action": "read",
          "resource": "*/pr-review-base-*",
          "effect": "allow",
        },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
      ],
    },
  },

  "compaction": {
    "auto": true,
    // With no buffer, auto compaction starts at each model's limit.input (300,000
    // for the models below). Models without one only compact once they overflow.
    "buffer": 0,
  },

  // Unset limit fields keep their models.dev values.
  "providers": {
    "anthropic": {
      "models": {
        "claude-fable-5-2": {
          "limit": { "input": 300000 },
        },
        "claude-opus-5-5": {
          "limit": { "input": 300000 },
        },
      },
    },
    "openai": {
      "models": {
        "gpt-6.2-astra": {
          "limit": { "input": 300000 },
        },
        "gpt-6.2-astra-fast": {
          "limit": { "input": 300000 },
        },
        "gpt-6.2-sol": {
          "limit": { "input": 300000 },
        },
        "gpt-6.2-sol-fast": {
          "limit": { "input": 300000 },
        },
      },
    },
  },

  "mcp": {
    "servers": {
      "linear-prinsur": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--caps=network",
          "--grant-permissions=microphone",
        ],
      },
    },
  },
}
