{
  "$schema": "https://opencode.ai/config.json",

  // Auth plugin stays first so the quota plugin can detect its credentials.
  //
  // The quota entry points at ~/.local/share/opencode-quota-shim, a small
  // wrapper around a local build of slkiser/opencode-quota PR #196 (v2 TUI
  // migration) plus ransagy's session_v2 storage fix, built from
  // ransagy/opencode-quota-v2@fix/tokens-v2-session-store in
  // ~/.local/share/opencode-quota-v2.
  //
  // The wrapper exists because OpenCode only accepts a local plugin package
  // whose entrypoints sit at the package root; it ignores "main" and drops the
  // package silently when "exports" points into dist/. The wrapper re-exports
  // the built TUI plugin from a root-level ./tui entrypoint.
  //
  // The local build also carries a patch to src/lib/runtime-provider-ids.ts:
  // upstream still calls the OpenCode 1 endpoint for the provider list, which
  // hides every provider except openai. Track it at PR #196 and issue #229.
  // Another local patch labels Claude as Anthropic and detects its plan via
  // /api/oauth/profile, cached per OAuth token for five minutes.
  //
  // TODO: switch back to "@slkiser/opencode-quota" once upstream publishes a
  // release that supports OpenCode 2, then delete both local directories:
  //   rm -rf ~/.local/share/opencode-quota-shim ~/.local/share/opencode-quota-v2
  "plugins": [
    "@henadev/opencode-anthropic-auth@latest",
    "/Users/ronaldluo/.local/share/opencode-quota-shim",
  ],

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/auth.json", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },

    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "chmod 777 *", "effect": "ask" },
  ],

  "compaction": {
    "auto": true,
    // With no buffer, auto compaction starts at each model's limit.input (200,000
    // for the models below). Models without one only compact once they overflow.
    "buffer": 0,
  },

  // Unset limit fields keep their models.dev values.
  "providers": {
    "anthropic": {
      "models": {
        "claude-fable-5-1": {
          "limit": { "input": 200000 },
        },
        "claude-opus-5": {
          "limit": { "context": 1000000, "input": 200000, "output": 128000 },
        },
        "claude-opus-5-5": {
          "limit": { "input": 200000 },
        },
        "claude-opus-5-fast": {
          "limit": { "input": 200000 },
        },
      },
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": { "context": 1050000, "input": 200000, "output": 128000 },
        },
        "gpt-5.6-terra": {
          "limit": { "input": 200000 },
        },
        "gpt-6-astra": {
          "limit": { "input": 200000 },
        },
        "gpt-6-astra-fast": {
          "limit": { "input": 200000 },
        },
        "gpt-6.1-sol": {
          "limit": { "input": 200000 },
        },
      },
    },
  },
}
