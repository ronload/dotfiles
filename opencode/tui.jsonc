{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "https://raw.githubusercontent.com/folke/tokyonight.nvim/main/extras/opencode/tokyonight_moon.json",
  "keybinds": {
    // release ctrl-p to use readline keys
    "command_list": "ctrl+shift+p",

    // readline keys
    "input_move_up": "up,ctrl+p",
    "input_move_down": "down,ctrl+n",

    // readline keys in input history
    "history_previous": "up,ctrl+p",
    "history_next": "down,ctrl+n"
  },
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ]
}
