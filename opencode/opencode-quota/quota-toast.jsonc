{
  "enableToast": false,
  "tuiCommandDisplay": "dialog",

  "enabledProviders": "auto",
  "formatStyle": "allWindows",
  "percentDisplayMode": "used",
  "showSessionTokens": false,

  "tuiSidebarPanel": {
    "enabled": true,
    "formatStyle": "allWindows"
  },

  "tuiCompactStatus": {
    "enabled": false
  }
}
