{
  "$schema": "https://opencode.ai/v2/cli.json",

  "theme": {
    "name": "tokyonight-moon",
    "mode": "dark"
  },

  "tabs": {
    "enabled": false
  },

  "cursor": {
    "style": "block",
    "blinking": false
  },

  "attention": {
    "notifications": true,
    "sound": false
  },

  "keybinds": {
    "command.palette.show": "<leader>k",

    "input.move.up": "up,ctrl+p",
    "input.move.down": "down,ctrl+n",
    "input.backspace": "backspace,shift+backspace,ctrl+h",

    "session.background": "<leader>j",
    "session.first": "home,alt+home",

    "prompt.history.previous": "up,ctrl+p",
    "prompt.history.next": "down,ctrl+n",

    "prompt.editor": "ctrl+g"
  }
}
